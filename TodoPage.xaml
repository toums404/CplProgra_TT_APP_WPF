<Page x:Class="CplProgra_TT_APP_WPF.TodoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CplProgra_TT_APP_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TodoPage">
    <Page.Resources><!--//declaration des converttisseur de couleur et de txt-->
        <local:TaskColorConverter x:Key="ColorConverter" />
        <local:TaskStrikeConverter x:Key="StrikeConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtNewTask" Width="300" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Ajouter" Click="BtnAdd_Click" Padding="10,5"/>
        </StackPanel>

        
        <ListBox x:Name="lstTasks" Grid.Row="1" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <!--//checkbox de isdone-->
                        <CheckBox IsChecked="{Binding IsDone, UpdateSourceTrigger=PropertyChanged}" 
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!--//texte de la tache avec couleur et barré si fait-->
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                 Foreground="{Binding IsDone, Converter={StaticResource ColorConverter}}"
                                 TextDecorations="{Binding IsDone, Converter={StaticResource StrikeConverter}}"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Width="400"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--//boutons pour supprimer et enregistrer les taches-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Supprimer la sélection" Click="BtnDelete_Click" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" Click="BtnSave_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Page>
