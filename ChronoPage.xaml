<Page x:Class="CplProgra_TT_APP_WPF.ChronoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CplProgra_TT_APP_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChronoPage">
    <Page.DataContext>
        <local:ChronoViewModel />
    </Page.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Chrono -->

            <RowDefinition Height="Auto" />
            <!-- btn -->
        </Grid.RowDefinitions>

        <!-- cadran chrono -->
        <Grid Grid.Row="0" Width="200" Height="200">

            <Ellipse Stroke="#2C3E50" StrokeThickness="4" Fill="#ECF0F1"/>

            <!-- pc -->
            <Ellipse Width="10" Height="10" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- aiguille min -->
            <Grid>
                <Grid.LayoutTransform>
                    <RotateTransform Angle="{Binding MinutesAngle}" />
                </Grid.LayoutTransform>
                <!-- aiguille place en haut -->
                <Rectangle Width="4" Height="80" Fill="Black" VerticalAlignment="Top" Margin="0,20,0,0" />
            </Grid>

            <!-- aiguille seconde -->
            <Grid>
                <Grid.LayoutTransform>
                    <RotateTransform Angle="{Binding SecondsAngle}" />
                </Grid.LayoutTransform>
                <Rectangle Width="2" Height="90" Fill="Red" VerticalAlignment="Top" Margin="0,10,0,0" />
            </Grid>
        </Grid>

        <!-- btn qui gere plus des clics mais des cmd -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Démarrer" Command="{Binding StartCommand}" Padding="15,5" Margin="5"/>
            <Button Content="Arrêter" Command="{Binding StopCommand}" Padding="15,5" Margin="5"/>
            <Button Content="Réinitialiser" Command="{Binding ResetCommand}" Padding="15,5" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
